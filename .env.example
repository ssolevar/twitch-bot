# Required Twitch credentials
TWITCH_BOT_USERNAME=
TWITCH_CHANNEL=
TWITCH_CLIENT_ID=
TWITCH_ACCESS_TOKEN=
# Optional Authorization Code refresh credentials (keep private)
TWITCH_REFRESH_TOKEN=
TWITCH_CLIENT_SECRET=
# Optional profile name from config/profiles.json
BOT_PROFILE=
BOT_LANGUAGE=ru

# Base command settings
COMMAND_PREFIX=!
MAX_COMMAND_REPEAT=10
COMMAND_REPEAT_DELAY_MS=700
TIMER_MIN_CHAT_MESSAGES=5
AUTO_REPLY_COOLDOWN_SECONDS=30
ACTIVE_CHATTER_WINDOW_MINUTES=15
STREAM_INFO_CACHE_SECONDS=30
PIN_DURATION_SECONDS=600
PIN_MESSAGE=
PIN_QUEUE_AUTO_ROTATE=false
PIN_QUEUE_INTERVAL_SECONDS=600
LOG_LEVEL=info
LOG_FILE_MAX_BYTES=5242880
LOG_FILE_BACKUPS=3

# EventSub messages (OAuth scopes depend on enabled event types)
ENABLE_EVENTSUB=false
EVENT_FOLLOW_MESSAGE=true
EVENT_SUB_MESSAGE=true
EVENT_RAID_MESSAGE=true
EVENT_GIFT_MESSAGE=false
EVENT_RESUB_MESSAGE=false
EVENT_CHEER_MESSAGE=false
EVENT_UPDATE_MESSAGE=false
EVENT_ONLINE_MESSAGE=false
EVENT_OFFLINE_MESSAGE=false
EVENT_FOLLOW_TEMPLATE=
EVENT_SUB_TEMPLATE=
EVENT_RAID_TEMPLATE=
EVENT_GIFT_TEMPLATE=
EVENT_RESUB_TEMPLATE=
EVENT_CHEER_TEMPLATE=
EVENT_UPDATE_TEMPLATE=
EVENT_ONLINE_TEMPLATE=
EVENT_OFFLINE_TEMPLATE=

# Optional weather command (Open-Meteo does not need an API key)
ENABLE_WEATHER=false
WEATHER_TIMEOUT_MS=10000
WEATHER_ALLOWED_USERNAMES=

# Optional FACEIT Data API (CS2 Elo)
FACEIT_API_KEY=
FACEIT_DEFAULT_NICKNAME=
FACEIT_GAME_ID=cs2

# AutoMod is disabled until you configure rules and Twitch moderation permissions
ENABLE_AUTOMOD=false
AUTOMOD_TIMEOUT_SECONDS=60
AUTOMOD_STREAK_WINDOW_SECONDS=600
AUTOMOD_MAX_TIMEOUT_SECONDS=3600
AUTOMOD_CAPS_ENABLED=false
AUTOMOD_SPAM_ENABLED=false
AUTOMOD_CAPS_MIN_LETTERS=12
AUTOMOD_CAPS_RATIO=0.8
AUTOMOD_SPAM_REPEAT_COUNT=6
AUTOMOD_SPAM_CHARACTER_LIMIT=10
AUTOMOD_SPAM_URL_LIMIT=3
AUTOMOD_LINK_ENABLED=false
AUTOMOD_LINK_ALLOWED_DOMAINS=
AUTOMOD_SPAM_WINDOW_SECONDS=10
AUTOMOD_SPAM_MESSAGE_LIMIT=6
AUTOMOD_REPEAT_ENABLED=false
AUTOMOD_REPEAT_WINDOW_SECONDS=60
AUTOMOD_REPEAT_MESSAGE_LIMIT=3
AUTOMOD_REPEAT_MIN_LENGTH=8
AUTOMOD_BLACKLIST_WORDS=
AUTOMOD_WHITELIST_WORDS=
AUTOMOD_BLACKLIST_USERNAMES=
AUTOMOD_WHITELIST_USERNAMES=
AUTOMOD_EXEMPT_MODERATORS=true
AUTOMOD_EXEMPT_VIPS=false
AUTOMOD_EXEMPT_SUBSCRIBERS=false
